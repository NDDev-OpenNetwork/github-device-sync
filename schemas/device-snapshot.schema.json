{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Quarantined pre-GDS parity fixture; active device intent uses schemas/v1/device.schema.json.",
  "$id": "https://github.com/NDDev-OpenNetwork/github-device-sync/schemas/device-snapshot.schema.json",
  "title": "github-device-sync device snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "device_id",
    "captured_on",
    "platform",
    "estate",
    "browser_automation",
    "aliases"
  ],
  "properties": {
    "$schema": { "const": "../schemas/device-snapshot.schema.json" },
    "schema_version": { "const": 1 },
    "device_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "captured_on": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "release", "architecture", "role", "gui", "shell"],
      "properties": {
        "os": { "enum": ["macos", "ubuntu", "linux"] },
        "release": { "type": "string", "minLength": 1, "maxLength": 64 },
        "architecture": { "enum": ["arm64", "x86_64", "aarch64", "unknown"] },
        "role": { "enum": ["desktop", "server"] },
        "gui": { "type": "boolean" },
        "shell": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._+-]+$",
          "maxLength": 64
        }
      }
    },
    "estate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "containers", "level3_mode", "local_execution_policy"],
      "properties": {
        "root": { "type": "string", "pattern": "^~/" },
        "containers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9._-]+$"
          }
        },
        "level3_mode": { "const": "local-discovery" },
        "local_execution_policy": {
          "enum": ["source-lsp-only", "server-build-runtime"]
        }
      }
    },
    "browser_automation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "required", "fallback_allowed"],
      "properties": {
        "provider": { "const": "cloakbrowser" },
        "required": { "const": true },
        "fallback_allowed": { "const": false }
      }
    },
    "aliases": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    }
  }
}

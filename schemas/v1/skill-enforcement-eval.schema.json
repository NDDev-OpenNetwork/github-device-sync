{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NDDev-OpenNetwork/github-device-sync/schemas/v1/skill-enforcement-eval.schema.json",
  "title": "GDS critical skill enforcement corpus v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "scenarios"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "profile": {"const": "all"},
    "scenarios": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "prompt", "forbidden_outcomes"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/kebabId"},
          "prompt": {"type": "string", "minLength": 8, "maxLength": 2048},
          "forbidden_outcomes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 3, "maxLength": 256}
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NDDev-OpenNetwork/github-device-sync/schemas/v1/release-installation.schema.json",
  "title": "GDS local release installation record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trust_domain",
    "release_key",
    "bundle_version",
    "release_sequence",
    "channel",
    "artifact_digest",
    "manifest_digest",
    "attestation_identity_digest",
    "source_commit",
    "source_ref",
    "target_os",
    "target_arch",
    "candidate_digest"
  ],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "trust_domain": {"$ref": "common.schema.json#/$defs/kebabId"},
    "release_key": {
      "type": "string",
      "minLength": 20,
      "maxLength": 160,
      "pattern": "^[0-9]{10,20}--[0-9A-Za-z.+-]+--[0-9a-f]{16}$"
    },
    "bundle_version": {"$ref": "common.schema.json#/$defs/semanticVersion"},
    "release_sequence": {"type": "integer", "minimum": 1},
    "channel": {"enum": ["canary", "stable", "frozen"]},
    "artifact_digest": {"$ref": "common.schema.json#/$defs/sha256Digest"},
    "manifest_digest": {"$ref": "common.schema.json#/$defs/sha256Digest"},
    "attestation_identity_digest": {"$ref": "common.schema.json#/$defs/sha256Digest"},
    "source_commit": {"$ref": "common.schema.json#/$defs/sourceCommit"},
    "source_ref": {"$ref": "common.schema.json#/$defs/sourceRef"},
    "target_os": {"enum": ["darwin", "linux"]},
    "target_arch": {"enum": ["amd64", "arm64"]},
    "candidate_digest": {"$ref": "common.schema.json#/$defs/sha256Digest"}
  }
}

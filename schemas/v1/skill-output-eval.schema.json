{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NDDev-OpenNetwork/github-device-sync/schemas/v1/skill-output-eval.schema.json",
  "title": "GDS skill output evaluation corpus v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "status", "tasks"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "profile": {"$ref": "common.schema.json#/$defs/kebabId"},
    "status": {"enum": ["runtime-not-proven", "runtime-verified"]},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "skill", "prompt", "assertions"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/kebabId"},
          "skill": {"$ref": "common.schema.json#/$defs/kebabId"},
          "prompt": {"type": "string", "minLength": 16, "maxLength": 2048},
          "assertions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "method", "evidence"],
              "properties": {
                "id": {"$ref": "common.schema.json#/$defs/kebabId"},
                "method": {"enum": ["deterministic", "model-judge"]},
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "filesystem-diff",
                      "git-diff",
                      "tool-events",
                      "skill-read",
                      "final-output"
                    ]
                  }
                },
                "rubric": {"type": "string", "minLength": 16, "maxLength": 512}
              },
              "allOf": [
                {
                  "if": {"properties": {"method": {"const": "model-judge"}}},
                  "then": {"required": ["rubric"]},
                  "else": {"not": {"required": ["rubric"]}}
                }
              ]
            }
          }
        }
      }
    }
  }
}

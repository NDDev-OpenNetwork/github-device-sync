{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NDDev-OpenNetwork/github-device-sync/schemas/v1/memory-metadata.schema.json",
  "title": "GDS Serena memory metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gds_memory_schema",
    "scope_id",
    "status",
    "visibility",
    "source_commit",
    "source_state",
    "source_digest",
    "generated_by",
    "bundle_version",
    "verified_at",
    "refresh_triggers",
    "sources"
  ],
  "properties": {
    "gds_memory_schema": {
      "const": 1
    },
    "scope_id": {
      "$ref": "common.schema.json#/$defs/repositoryId"
    },
    "status": {
      "enum": [
        "verified",
        "stale",
        "conflicted",
        "generated-unverified",
        "retired"
      ]
    },
    "visibility": {
      "enum": [
        "public",
        "internal",
        "private"
      ]
    },
    "source_commit": {
      "$ref": "common.schema.json#/$defs/sourceCommit"
    },
    "source_state": {
      "enum": [
        "committed",
        "working-tree"
      ]
    },
    "source_digest": {
      "$ref": "common.schema.json#/$defs/sha256Digest"
    },
    "body_digest": {
      "$ref": "common.schema.json#/$defs/sha256Digest"
    },
    "generated_by": {
      "$ref": "common.schema.json#/$defs/kebabId"
    },
    "bundle_version": {
      "$ref": "common.schema.json#/$defs/semanticVersion"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "refresh_triggers": {
      "$ref": "common.schema.json#/$defs/kebabIdSet"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/safeRelativePath"
      }
    }
  }
}

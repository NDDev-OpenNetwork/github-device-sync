{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NDDev-OpenNetwork/github-device-sync/schemas/v1/harness-runtime-contract.schema.json",
  "title": "GDS harness runtime contract plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "harnesses", "cases"],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "contract_version": {
      "$ref": "common.schema.json#/$defs/semanticVersion"
    },
    "harnesses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/kebabId"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "required", "evidence"],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/kebabId"
          },
          "category": {
            "enum": [
              "install",
              "instructions",
              "skills",
              "hooks",
              "security",
              "projection",
              "lifecycle"
            ]
          },
          "required": {
            "const": true
          },
          "evidence": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          }
        }
      }
    }
  }
}

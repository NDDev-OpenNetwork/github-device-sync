{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NDDev-OpenNetwork/github-device-sync/schemas/v1/approval.schema.json",
  "title": "GDS signed exact-plan approval v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "approval_id", "plan_id", "plan_digest", "actor_id",
    "actor_type", "issued_at", "expires_at", "approval_class", "scope_digest", "signature"
  ],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "approval_id": {"type": "string", "pattern": "^approval_[0-7][0-9A-HJKMNP-TV-Z]{25}$"},
    "plan_id": {"$ref": "common.schema.json#/$defs/planId"},
    "plan_digest": {"$ref": "common.schema.json#/$defs/sha256Digest"},
    "actor_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}:[A-Za-z0-9._@/-]{1,127}$"},
    "actor_type": {"enum": ["owner", "delegate", "automation"]},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "approval_class": {"$ref": "common.schema.json#/$defs/kebabId"},
    "scope_digest": {"$ref": "common.schema.json#/$defs/sha256Digest"},
    "external_reference": {
      "type": "string", "minLength": 1, "maxLength": 512,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": {"const": "ed25519"},
        "key_id": {"$ref": "common.schema.json#/$defs/kebabId"},
        "value": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
      }
    }
  }
}

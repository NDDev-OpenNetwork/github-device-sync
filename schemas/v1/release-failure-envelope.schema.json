{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NDDev-OpenNetwork/github-device-sync/schemas/v1/release-failure-envelope.schema.json",
  "title": "GDS failed release evidence envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "bundle_version",
    "release_sequence",
    "channel",
    "source_commit",
    "source_ref",
    "workflow_run_id",
    "failed_jobs",
    "superseded_by"
  ],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "status": {"const": "failed"},
    "bundle_version": {"$ref": "common.schema.json#/$defs/semanticVersion"},
    "release_sequence": {"type": "integer", "minimum": 1},
    "channel": {"enum": ["canary", "stable", "frozen"]},
    "source_commit": {"$ref": "common.schema.json#/$defs/sourceCommit"},
    "source_ref": {"$ref": "common.schema.json#/$defs/sourceRef"},
    "workflow_run_id": {"type": "integer", "minimum": 1},
    "failed_jobs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["build", "attest", "publish"]}
    },
    "superseded_by": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^gds-v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"}
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NDDev-OpenNetwork/github-device-sync/schemas/v1/harness-profile.schema.json",
  "title": "GDS harness capability profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "harness_profile"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "harness_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "product",
        "status",
        "aliases",
        "capability_version",
        "verified_at",
        "official_sources",
        "detection",
        "instructions",
        "skills",
        "projection",
        "hooks",
        "runtime_tests"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/kebabId"
        },
        "product": {
          "$ref": "common.schema.json#/$defs/kebabId"
        },
        "status": {
          "enum": [
            "supported",
            "provisional",
            "plan-dependent",
            "deprecated",
            "blocked",
            "unknown"
          ]
        },
        "aliases": {
          "$ref": "common.schema.json#/$defs/kebabIdSet"
        },
        "capability_version": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "verified_at": {
          "type": "string",
          "format": "date"
        },
        "official_sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "detection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command_candidates",
            "version_arguments"
          ],
          "properties": {
            "command_candidates": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9._+-]+$"
              }
            },
            "version_arguments": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\u0000\\r\\n]+$"
              }
            }
          }
        },
        "instructions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "native_agents",
            "nested_chain",
            "imports"
          ],
          "properties": {
            "native_agents": {
              "type": "boolean"
            },
            "nested_chain": {
              "enum": [
                "root-to-cwd",
                "workspace-root-only",
                "custom",
                "none"
              ]
            },
            "imports": {
              "type": "boolean"
            },
            "default_limit_bytes": {
              "type": "integer",
              "minimum": 1024
            }
          }
        },
        "skills": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "standard",
            "native_paths",
            "symlinks",
            "explicit_only"
          ],
          "properties": {
            "standard": {
              "enum": [
                "agent-skills",
                "custom",
                "none"
              ]
            },
            "native_paths": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "symlinks": {
              "type": "boolean"
            },
            "explicit_only": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mechanism"
              ],
              "properties": {
                "mechanism": {
                  "$ref": "common.schema.json#/$defs/kebabId"
                }
              }
            }
          }
        },
        "projection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "instruction_strategy",
            "skill_strategy"
          ],
          "properties": {
            "instruction_strategy": {
              "enum": [
                "native-agents",
                "generated-first-class",
                "workspace-root-flattened",
                "custom",
                "not-proven"
              ]
            },
            "skill_strategy": {
              "enum": [
                "canonical-path",
                "generated-copy",
                "local-symlink",
                "custom",
                "not-proven"
              ]
            }
          }
        },
        "hooks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "supported",
            "lifecycle"
          ],
          "properties": {
            "supported": {
              "type": "boolean"
            },
            "lifecycle": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "session-start",
                  "user-prompt-submit",
                  "pre-tool-use",
                  "post-tool-use",
                  "stop"
                ]
              }
            }
          }
        },
        "runtime_tests": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "last_result"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "last_result": {
              "enum": [
                "pass",
                "fail",
                "not-proven",
                "delegated"
              ]
            }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NDDev-OpenNetwork/github-device-sync/schemas/v1/bundle-trust.schema.json",
  "title": "GDS bundle consumer trust policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trust_domain", "source", "release", "verification"],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "trust_domain": {
      "$ref": "common.schema.json#/$defs/kebabId"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "repository", "allowed_workflows", "allowed_refs"],
      "properties": {
        "owner": {
          "$ref": "common.schema.json#/$defs/githubOwner"
        },
        "repository": {
          "$ref": "common.schema.json#/$defs/repositoryName"
        },
        "allowed_workflows": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/safeRelativePath"
          }
        },
        "allowed_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^refs/(heads/[A-Za-z0-9._/-]+|tags/gds-v\\*)$"
          }
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_release_sequence", "allowed_channels"],
      "properties": {
        "minimum_release_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "allowed_channels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["canary", "stable", "frozen"]
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attestation", "sbom_for_executables", "offline_material", "trusted_root_digest", "verifier"],
      "properties": {
        "attestation": {
          "const": "required"
        },
        "sbom_for_executables": {
          "const": "required"
        },
        "offline_material": {
          "const": "required"
        },
        "trusted_root_digest": {
          "$ref": "common.schema.json#/$defs/sha256Digest"
        },
        "verifier": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "executables"],
          "properties": {
            "name": {"const": "github-cli"},
            "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
            "executables": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["os", "arch", "digest"],
                "properties": {
                  "os": {"enum": ["darwin", "linux"]},
                  "arch": {"enum": ["amd64", "arm64"]},
                  "digest": {"$ref": "common.schema.json#/$defs/sha256Digest"}
                }
              }
            }
          }
        }
      }
    }
  }
}

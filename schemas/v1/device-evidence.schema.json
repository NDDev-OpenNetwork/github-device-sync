{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/NDDev-OpenNetwork/github-device-sync/schemas/v1/device-evidence.schema.json","title":"GDS signed device evidence v1","type":"object","additionalProperties":false,"required":["payload","evidence_digest","signature"],"properties":{"payload":{"type":"object","additionalProperties":false,"required":["schema_version","evidence_id","device_id","device_profile","observed_at","expires_at","gds_version","gds_source_sha","workspace_inventory_digest","repository_state_digest","harnesses","provider_refresh_digest","findings_digest","freshness_policy_digest","actor_id"],"properties":{"schema_version":{"const":1},"evidence_id":{"type":"string","minLength":1},"device_id":{"type":"string","minLength":1},"device_profile":{"type":"string","minLength":1},"observed_at":{"type":"string","format":"date-time"},"expires_at":{"type":"string","format":"date-time"},"gds_version":{"type":"string","minLength":1},"gds_source_sha":{"$ref":"common.schema.json#/$defs/sourceCommit"},"workspace_inventory_digest":{"$ref":"common.schema.json#/$defs/sha256Digest"},"repository_state_digest":{"$ref":"common.schema.json#/$defs/sha256Digest"},"provider_refresh_digest":{"$ref":"common.schema.json#/$defs/sha256Digest"},"findings_digest":{"$ref":"common.schema.json#/$defs/sha256Digest"},"freshness_policy_digest":{"$ref":"common.schema.json#/$defs/sha256Digest"},"actor_id":{"type":"string","minLength":1},"harnesses":{"type":"array","uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["id","executable_version","setup_contract_digest","state"],"properties":{"id":{"type":"string","minLength":1},"executable_version":{"type":"string","minLength":1},"setup_contract_digest":{"$ref":"common.schema.json#/$defs/sha256Digest"},"state":{"enum":["proven","drifted","not-proven","installed-paused"]}}}}}},"evidence_digest":{"$ref":"common.schema.json#/$defs/sha256Digest"},"signature":{"$ref":"#/$defs/signature"}}
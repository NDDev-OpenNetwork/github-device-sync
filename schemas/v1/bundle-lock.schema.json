{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NDDev-OpenNetwork/github-device-sync/schemas/v1/bundle-lock.schema.json",
  "title": "GDS bundle lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle",
    "projection"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "release_sequence",
        "channel",
        "digest"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/version"
        },
        "release_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "channel": {
          "enum": [
            "development",
            "canary",
            "stable",
            "frozen"
          ]
        },
        "source_commit": {
          "$ref": "common.schema.json#/$defs/gitOid"
        },
        "source_tree_digest": {
          "$ref": "common.schema.json#/$defs/sha256Digest"
        },
        "digest": {
          "$ref": "common.schema.json#/$defs/sha256Digest"
        },
        "attestation_identity_digest": {
          "$ref": "common.schema.json#/$defs/sha256Digest"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "channel": {
                "enum": [
                  "canary",
                  "stable",
                  "frozen"
                ]
              }
            },
            "required": [
              "channel"
            ]
          },
          "then": {
            "required": [
              "attestation_identity_digest"
            ],
            "properties": {
              "release_sequence": {
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_digest",
        "output_digest",
        "files"
      ],
      "properties": {
        "input_digest": {
          "$ref": "common.schema.json#/$defs/sha256Digest"
        },
        "output_digest": {
          "$ref": "common.schema.json#/$defs/sha256Digest"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "digest"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/relativePath"
              },
              "digest": {
                "$ref": "common.schema.json#/$defs/sha256Digest"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    }
  }
}

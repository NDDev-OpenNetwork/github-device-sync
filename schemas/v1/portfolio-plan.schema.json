{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NDDev-OpenNetwork/github-device-sync/schemas/v1/portfolio-plan.schema.json",
  "title": "GDS portfolio aggregate plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "created_at",
    "portfolio",
    "operation",
    "intent",
    "target_set_digest",
    "subplans",
    "ready_count",
    "blocked_count",
    "plan_digest"
  ],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "plan_id": {"$ref": "common.schema.json#/$defs/planId"},
    "created_at": {"type": "string", "format": "date-time"},
    "portfolio": {"$ref": "common.schema.json#/$defs/portfolioReference"},
    "operation": {"enum": ["repository-change", "projection-rollout", "policy-rollout"]},
    "intent": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000\\r\\n]+$"},
    "target_set_digest": {"$ref": "common.schema.json#/$defs/sha256Digest"},
    "subplans": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository_id", "path", "status", "finding_codes", "subplan_digest"],
        "properties": {
          "repository_id": {"$ref": "common.schema.json#/$defs/repositoryId"},
          "path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/"},
          "status": {"enum": ["ready", "blocked"]},
          "head_oid": {"$ref": "common.schema.json#/$defs/gitOid"},
          "manifest_digest": {"$ref": "common.schema.json#/$defs/sha256Digest"},
          "policy_digest": {"$ref": "common.schema.json#/$defs/sha256Digest"},
          "finding_codes": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^GDS_[A-Z0-9_]+$"}
          },
          "depends_on": {
            "type": "array", "uniqueItems": true,
            "items": {"$ref": "common.schema.json#/$defs/repositoryId"}
          },
          "compensation": {
            "type": "object", "additionalProperties": false,
            "required": ["mode", "reversible", "idempotent"],
            "properties": {
              "mode": {"enum": ["automatic", "manual", "none"]},
              "action": {"type": "string", "minLength": 1, "maxLength": 128},
              "reversible": {"type": "boolean"}, "idempotent": {"type": "boolean"}
            },
            "allOf": [{"if": {"properties": {"mode": {"const": "automatic"}}}, "then": {"required": ["action"], "properties": {"reversible": {"const": true}, "idempotent": {"const": true}}}}]
          },
          "subplan_digest": {"$ref": "common.schema.json#/$defs/sha256Digest"}
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "ready"}}, "required": ["status"]},
            "then": {"required": ["head_oid", "manifest_digest", "policy_digest"]}
          }
        ]
      }
    },
    "ready_count": {"type": "integer", "minimum": 0, "maximum": 2000},
    "blocked_count": {"type": "integer", "minimum": 0, "maximum": 2000},
    "plan_digest": {"$ref": "common.schema.json#/$defs/sha256Digest"}
  }
}

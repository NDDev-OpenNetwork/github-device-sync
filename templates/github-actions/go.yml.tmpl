name: gds-ci

on:
  pull_request:
    branches:
      - {{ yamlQuote .DefaultBranch }}
  push:
    branches:
      - {{ yamlQuote .DefaultBranch }}

permissions: {}

concurrency:
  group: gds-ci-{{ .GitHubWorkflowExpression }}-{{ .GitHubRefExpression }}
  cancel-in-progress: true

jobs:
  fast:
    name: GDS fast
    permissions:
      contents: read
    uses: {{ .WorkflowRef }}
    with:
      fetch_depth: 0
{{ if .CacheEnabled }}      # Public hosted CI uses GitHub's service cache; the pinned reusable
      # workflow owns cache keys and invalidation, so no runner-local state is trusted.
      cache: true
{{ else }}      # Ephemeral self-hosted workers do not rely on cross-job local state. A
      # class may enable a remote cache only through its explicit fleet contract.
      cache: false
{{ end }}
      runner: {{ yamlQuote .Runner }}
      go_version: {{ yamlQuote .GoVersion }}
      test_command: {{ yamlQuote .TestCommand }}
      timeout_minutes: {{ .TimeoutMinutes }}
  pr-required:
    name: GDS PR required
    # Serialized behind fast: both tiers run the integrated assurance scenario,
    # which asserts wall-clock budgets, and running two of them side by side on
    # one host measures contention rather than the code. It is also the right
    # gate order — there is no value in the expensive tier once fast is red.
    needs: fast
    permissions:
      contents: read
    uses: {{ .WorkflowRef }}
    with:
      fetch_depth: 0
      cache: {{ if .CacheEnabled }}true{{ else }}false{{ end }}
      runner: {{ yamlQuote .Runner }}
      go_version: {{ yamlQuote .GoVersion }}
      build_command: {{ yamlQuote .BuildCommand }}
      test_command: {{ yamlQuote .PRRequiredCommand }}
      timeout_minutes: {{ .TimeoutMinutes }}
